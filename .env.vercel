# Browser-visible configuration for https://handyst.techyst.net.
# Paste into Vercel → Settings → Environment Variables, or import with
#   vercel env add < .env.vercel
# Server secrets do not belong here; they are compiled into the bundle.
VITE_BACKEND_BASE_URL=https://api.handyst.techyst.net
VITE_BACKEND_HOST=api.handyst.techyst.net
VITE_USE_TLS=true
